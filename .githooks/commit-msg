#!/usr/bin/env bash
set -euo pipefail

msg_file="${1:?commit-msg hook requires the commit message file}"

comment_char=$(git config --get core.commentChar || true)
if [ -z "$comment_char" ] || [ "$comment_char" = "auto" ]; then
  comment_char='#'
fi

subject=""
while IFS= read -r line || [ -n "$line" ]; do
  case "$line" in
    '' | "$comment_char"*) continue ;;
  esac
  subject="$line"
  break
done < "$msg_file"

case "$subject" in
  "Merge "* | "Revert "* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac

pattern='^(feat|fix|chore|docs|style|refactor|perf|test|build|ci|revert)(\([^)]+\))?!?: [^[:space:]].*$'

if ! [[ "$subject" =~ $pattern ]]; then
  echo "commit-msg: commit subject does not follow Conventional Commits." >&2
  echo "  got: $subject" >&2
  echo "  expected: <type>[(scope)][!]: <description>" >&2
  echo "  types: feat fix chore docs style refactor perf test build ci revert" >&2
  echo "  see CONTRIBUTING.md#commit-messages" >&2
  exit 1
fi
