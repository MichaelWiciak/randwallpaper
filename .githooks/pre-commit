#!/usr/bin/env bash
set -euo pipefail

staged_list=$(mktemp)
blob_file=$(mktemp)
trap 'rm -f "$staged_list" "$blob_file"' EXIT

if ! git diff --cached --name-only --diff-filter=ACMRT -z -- '*.go' > "$staged_list"; then
  echo "pre-commit: failed to list staged Go files." >&2
  exit 1
fi

if [ ! -s "$staged_list" ]; then
  exit 0
fi

unformatted=()
while IFS= read -r -d '' file; do
  index_entry=$(git ls-files -s -- "$file")
  mode=${index_entry%% *}

  case "$mode" in
    100644 | 100755) ;;
    *) continue ;;
  esac

  if ! git show ":$file" > "$blob_file"; then
    echo "pre-commit: failed to read staged contents of '$file'." >&2
    exit 1
  fi

  status=0
  listed=$(gofmt -l "$blob_file") || status=$?
  if [ "$status" -ne 0 ]; then
    echo "pre-commit: gofmt failed on staged contents of '$file'." >&2
    exit 1
  fi
  if [ -n "$listed" ]; then
    unformatted+=("$file")
  fi
done < "$staged_list"

if [ "${#unformatted[@]}" -gt 0 ]; then
  echo "pre-commit: the following staged files are not gofmt-formatted:" >&2
  printf '  %s\n' "${unformatted[@]}" >&2
  echo "Run 'gofmt -w <file>' and stage the result." >&2
  exit 1
fi

echo "pre-commit: go vet ./..."
go vet ./...
